{
  "name": "fichas",
  "version": "1.0.0",
  "description": "Prepare a talk on index cards and present it one card at a time.",
  "author": "Xavier Quirico",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierQuirico/fichas.git"
  },
  "homepage": "https://fichas-murex.vercel.app",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --import ./tests/helpers/register.mjs --test tests/*.test.mjs",
    "test:integration": "node --experimental-strip-types --import ./tests/helpers/register.mjs --test tests/*.integration.test.ts",
    "test:components": "vitest run",
    "coverage:components": "vitest run --coverage",
    "coverage:server": "node --experimental-strip-types --import ./tests/helpers/register.mjs --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-include=\"app/api/**\" --test-coverage-include=\"db/**\" --test-coverage-exclude=\"tests/**\" --test tests/*.test.mjs tests/*.integration.test.ts",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --experimental-strip-types scripts/seed-demo.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@clerk/localizations": "4.23.0",
    "@clerk/nextjs": "7.9.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
